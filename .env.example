# ================================================================
# WorkPay (Mobile App) Environment Configuration Template
# ================================================================
# Copy this file to '.env' or '.env.local' in the WorkPay project root:
#   cp .env.example .env
#
# NOTE: Variables prefixed with 'EXPO_PUBLIC_' are automatically
# bundled into your client JavaScript by Expo at build time.
# ================================================================

# ----------------------------------------------------------------
# 1. Backend API Base URL
# ----------------------------------------------------------------
# Choose the appropriate value for your environment:
#
# - Production Vercel Backend:
#   EXPO_PUBLIC_API_URL="https://work-pay-service.vercel.app"
#
# - Specific Vercel Deployment:
#   EXPO_PUBLIC_API_URL="https://work-pay-service-2w9558dhj-darkstars-projects-147b9795.vercel.app"
#
# - Android Studio Emulator:
#   EXPO_PUBLIC_API_URL="http://10.0.2.2:3000"
#
# - Physical Android / iOS device on the same Wi-Fi:
#   EXPO_PUBLIC_API_URL="http://192.168.1.xxx:3000"
#
# - Web Browser / iOS Simulator:
#   EXPO_PUBLIC_API_URL="http://localhost:3000"
#
EXPO_PUBLIC_API_URL="http://localhost:3000"

# ----------------------------------------------------------------
# 2. Google AdMob Ad Unit IDs
# ----------------------------------------------------------------
# Leave empty during development to automatically use official Google test IDs
# For production, replace with your live AdMob Ad Unit IDs:
EXPO_PUBLIC_ADMOB_BANNER_ID=""
EXPO_PUBLIC_ADMOB_APP_OPEN_ID=""
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=""
