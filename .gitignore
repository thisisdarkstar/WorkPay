# dependencies
node_modules/

# Expo
.expo/
.eas/
dist/
web-build/
expo-env.d.ts

# Native Prebuild directories — iOS is regenerated; android/ SOURCE is committed
# (we build directly from it and it holds manual native fixes). Build outputs,
# keystores, and signing secrets are excluded below.
/ios

# Signing secrets — NEVER commit (android/gradle.properties holds upload key passwords)
android/gradle.properties
android/app/debug.keystore

# Android build outputs & local configuration
.gradle/
android/.gradle/
android/build/
android/app/build/
android/.cxx/
android/app/.cxx/
android/local.properties
android/*.iml
android/app/*.iml
android/.idea/
android/captures/

# iOS build outputs & CocoaPods
ios/build/
ios/Pods/
ios/*.xcworkspace/
ios/*.xcuserdata/

# Native Keystores and Certificates
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision
*.der
extracted_keystore/
*keystore*.zip
@*keystore*
temp_so_check/

# Metro
.metro-health-check*

# Logs & debug
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# OS & Editor
.DS_Store
Thumbs.db
ehthumbs.db
*.pem
.idea/
.vscode/*
!.vscode/settings.json

# Local env files
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# TypeScript
*.tsbuildinfo

# Android Release binaries
*.apk
*.aab

app-example
